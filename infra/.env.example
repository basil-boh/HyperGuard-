# ─────────────────────────────────────────────────────────────────────────────
# HyperGuard environment
#
# Every credential below is OPTIONAL. With none set, the swarm runs end-to-end in
# a deterministic demo mode. Fill these in to light up live LLM dialogue,
# telephony, persistence, and the distributed event bus — no code changes needed.
# Copy this file to the repo root as `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Force the deterministic simulation even if keys are present (hermetic stage demo).
FORCE_DEMO_MODE=false

# ── Risk policy ───────────────────────────────────────────────────────────────
INTERVENTION_THRESHOLD=0.58
HARD_BLOCK_THRESHOLD=0.88
MAX_NEGOTIATION_TURNS=8
DEMO_STEP_DELAY=0.75

# ── LLM (Negotiator dialogue + post-call adjudication) ────────────────────────
# Note: the Digital Twin does NOT use a model — its risk score is a deterministic
# logistic function, so the common path costs nothing rather than costing little.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.5
LLM_TEMPERATURE=0.2

# Two tiers (see services/model_policy). Routine in-call lines run on the fast model;
# a confirmed scam, a hard-block-level risk, and every written artefact promote to deep.
# LLM_MODEL_FAST must be an id your key can actually reach — verify with:
#   python -c "from openai import OpenAI; OpenAI().chat.completions.create(model='gpt-5-mini', messages=[{'role':'user','content':'hi'}])"
# A wrong id used to fail silently to scripted lines; it now retries on the deep model
# and flags `degraded: true` in the case's model_usage, but check it anyway.
LLM_MODEL_FAST=gpt-5-mini
LLM_MODEL_DEEP=

# Optional USD per 1M tokens. Left at 0 the API still reports tokens, latency and the
# fast/deep token split — the tiering saving is measurable without these. Fill them in
# from your provider's current pricing page to also get dollars; a guessed rate is worse
# than no rate, which is why there are no defaults here.
LLM_PRICE_FAST_INPUT=0
LLM_PRICE_FAST_OUTPUT=0
LLM_PRICE_DEEP_INPUT=0
LLM_PRICE_DEEP_OUTPUT=0

# ── Voice / telephony (Voice Negotiator + Guardian SMS) ───────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Persistence (Supabase / Postgres) ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Distributed event bus (durability / replay) ───────────────────────────────
REDIS_URL=

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
